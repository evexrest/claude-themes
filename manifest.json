{
    "manifest_version": 3,
    "name": "Claude Themes",
    "version": "0.1.0",
    "description": "Backgrounds for claude.ai: presets or your own image, with opacity control. Unofficial, not made by Anthropic.",
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://claude.ai/*"],
            "css": ["theme.css"],
            "js": ["settings.js", "content.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "Claude Themes",
        "default_popup": "popup.html"
    },
    "options_page": "options.html"
}
