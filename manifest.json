{
    "manifest_version": 3,
    "minimum_chrome_version": "111",
    "name": "Claude Themes",
    "version": "0.20.0",
    "description": "Backgrounds, frames, side pictures, text colour and fonts for claude.ai. Unofficial, not made by Anthropic.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["storage", "unlimitedStorage"],
    "host_permissions": ["https://claude.ai/*"],
    "content_scripts": [
        {
            "matches": ["https://claude.ai/*"],
            "css": ["theme.css"],
            "js": ["settings.js", "content.js"],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open the Claude Themes editor",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+Shift+E" },
            "description": "Open or close the editor"
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["editor.html"],
            "matches": ["https://claude.ai/*"]
        }
    ],
    "options_page": "options.html"
}
