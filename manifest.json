{
    "manifest_version": 3,
    "name": "Claude Themes",
    "version": "0.9.0",
    "description": "Backgrounds, frames, side pictures, text colour and fonts for claude.ai. Unofficial, not made by Anthropic.",
    "permissions": ["storage", "unlimitedStorage"],
    "content_scripts": [
        {
            "matches": ["https://claude.ai/*"],
            "css": ["theme.css"],
            "js": ["settings.js", "content.js"],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open the Claude Themes editor"
    },
    "options_page": "options.html"
}
